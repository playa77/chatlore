# Copy to .env in the directory where you launch ChatLore. Never commit real keys.
CHATLORE_LLM_PROVIDER=openai
CHATLORE_LLM_BASE_URL=https://openrouter.ai/api/v1
CHATLORE_LLM_MODEL=z-ai/glm-5.3-flash
CHATLORE_LLM_REASONING=default
CHATLORE_LLM_API_KEY=

# A separate OpenRouter key, never borrowed from the chat client.
CHATLORE_EMBEDDING_PROVIDER=openrouter
CHATLORE_EMBEDDING_MODEL=openai/text-embedding-3-small
CHATLORE_EMBEDDING_API_KEY=
